# Copy to .env (gitignored) and fill in what you have. Everything is optional.
# Web search (any one): https://app.tavily.com  |  https://api-dashboard.search.brave.com  |  https://serper.dev
TAVILY_API_KEY=
# BRAVE_API_KEY=
# SERPER_API_KEY=
# PubMed: 10 requests/s instead of 3 (free): https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=
# Contact email for OpenAlex / Crossref "polite pool" (free, no signup)
OPENALEX_EMAIL=
# Free-tier LLMs (step 8 baselines; two different families recommended)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# https://console.groq.com/keys
GROQ_API_KEY=
# OPENROUTER_API_KEY=          # https://openrouter.ai/keys (use models ending in :free)
# TE_OPENROUTER_MODELS=
# Paid LLMs (optional)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
